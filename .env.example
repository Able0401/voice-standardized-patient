# Copy to functions/.env. Read by functions/dev.js locally and by the Firebase CLI on deploy.

# Required. Google AI Studio key.
GEMINI_API_KEY=

# Optional. A second key with its own spending limit, used instead of GEMINI_API_KEY when set.
GEMINI_DEMO_API_KEY=

# Comma-separated origins allowed to call the API (your hosting URLs). localhost:5173 and 5174 are always allowed.
DEMO_ORIGINS=https://your-site.web.app,https://your-site.firebaseapp.com

# Quota: sessions per IP per day, and overall per day. The counter fails closed.
DEMO_PER_IP=3
DEMO_PER_DAY=30

# Model (default shown).
GEMINI_LIVE_MODEL=gemini-3.8-live
